# MongoDB Atlas connection string (see README "Database setup" section for how to get this)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/blackcoffer_dashboard?retryWrites=true&w=majority

# Port the Express server listens on
PORT=5000

# Comma-separated list of origins allowed to call this API (your Vite dev server / deployed frontend)
CLIENT_ORIGIN=http://localhost:5173
